{
  "name": "cangxia-nas",
  "version": "0.2.1",
  "description": "藏匣 · 抖音收藏与本地媒体库",
  "author": "CangXia",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "test:ui": "vite build --ssr src/main.jsx --outDir .test-output/dom-build && node tests/workspace-ui.mjs",
    "test:layout": "npm run build && electron tests/layout-smoke.cjs",
    "test:nas-desktop": "npm run build && node scripts/nas-desktop-test.mjs"
  },
  "dependencies": {
    "sql.js": "1.14.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "^30.0.1",
    "vite": "8.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^0.577.0"
  },
  "build": {
    "appId": "local.cangxia.nas",
    "productName": "藏匣NAS版",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "CangXia-NAS-${version}-Windows-x64.exe"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "藏匣NAS版",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CangXia-NAS-${version}-Setup-x64.exe"
    }
  }
}
